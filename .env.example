# Copy to .env (gitignored) and fill in real values before `docker compose up`.
PG_DB=ereignis
PG_SUPERUSER=postgres
PG_SUPER_PASSWORD=change-me
PG_BIND_PORT=5434

# App-role password used by `psql -v app_pw=... -f sql/0001_ereignis.sql`.
APP_PW=change-me-too

# Optional: Artificial Analysis API key (https://artificialanalysis.ai) for the model
# catalog's intelligence/coding/agentic indices. Put it in a `.env` next to `modelle.json`
# or export it in the environment. Without it, `katalog-update` skips the step.
ARTIFICIALANALYSIS_API_KEY=

# Optional: override the path to modelle.json (model catalog data). Defaults to
# modelle.json in the folder above the package, falling back to the copy inside the package.
#SITZUNGSBELEG_MODELLE=/path/to/modelle.json

# Optional: Docker container name used for `docker exec ... psql` (see docker-compose.yml).
# Defaults to sitzungsbeleg-postgres.
#SITZUNGSBELEG_PG_CONTAINER=sitzungsbeleg-postgres

# Optional: relative folder for generated standardisation notes (gitignored). Defaults to _work/.
#SITZUNGSBELEG_WORK_DIR=_work/

# Optional: argv (as a JSON list) for the "apply fix" button in the chat column. The
# placeholder {handover} is substituted with the handover text. Unset -> the endpoint
# returns 501 and the button shows "not configured".
#SITZUNGSBELEG_FIX_LAUNCHER=["powershell","-File","C:/tools/open-assistant.ps1","-Handover","{handover}"]
